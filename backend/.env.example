# Genmashy Distributors - Environment Configuration
# Copy this file to .env and update with your actual values

# Application
APP_ENV=production
APP_DEBUG=false
APP_URL=https://genmashy.co.zw
MAINTENANCE_MODE=false

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=genmashy
DB_USERNAME=genmashy
DB_PASSWORD=your_secure_password_here

# Session
SESSION_LIFETIME=7200
SESSION_DOMAIN=.genmashy.co.zw

# Security
ALLOWED_HOSTS=genmashy.co.zw,www.genmashy.co.zw
TRUSTED_PROXIES=
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900
PASSWORD_MIN_LENGTH=8
REQUIRE_EMAIL_VERIFICATION=true

# Mail (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_FROM_ADDRESS=sales@genmashy.co.zw
MAIL_FROM_NAME="Genmashy Distributors"
MAIL_REPLY_TO_ADDRESS=sales@genmashy.co.zw
MAIL_REPLY_TO_NAME="Genmashy Support"

# Cache
CACHE_DRIVER=file

# Queue
QUEUE_CONNECTION=sync

# Logging
LOG_CHANNEL=daily
LOG_LEVEL=info